# ── Infraestructura Base ────────────────────────────────────────────────────────
PORT=3000
WORKER_PORT=8080

# La API se conecta con un rol SIN BYPASSRLS: así el aislamiento entre comercios lo impone
# PostgreSQL y no depende de que ninguna consulta olvide su `WHERE tenant_id`.
# El rol lo crea `./infra/scripts/create-api-role.sh` después de migrar.
DATABASE_URL=postgres://pos_api:pos_api@localhost:5432/pos_dian

# Rol dueño del esquema. Lo usan las migraciones, las semillas y el worker (sus tareas
# programadas —bandeja de salida, rollups, renovaciones— leen a través de todos los
# comercios por diseño, así que no pueden estar sujetas al filtro por tenant).
ADMIN_DATABASE_URL=postgres://pos:pos@localhost:5432/pos_dian
REDIS_URL=redis://localhost:6379

# ── Seguridad y Autenticación ─────────────────────────────────────────────────
# En producción el arranque RECHAZA este valor: se detectan los marcadores de posición y
# los secretos de poca variedad. Genera uno real:  openssl rand -base64 48
JWT_SECRET=replace-this-in-production-with-a-long-secret
JWT_EXPIRES_IN=8h
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Token para consultar /metrics. En producción, sin este valor el endpoint responde 404:
# las métricas exponen rutas, latencias y volumen de ventas por minuto.
#   openssl rand -hex 24
METRICS_TOKEN=

# Contraseña de PostgreSQL para el docker-compose de infraestructura local.
POSTGRES_PASSWORD=pos

# Plazo (ms) para drenar peticiones en vuelo durante un cierre ordenado. Por debajo del
# plazo del orquestador antes del SIGKILL (30 s en Kubernetes y la mayoría de PaaS).
SHUTDOWN_TIMEOUT_MS=25000

# ── DIAN Provider ─────────────────────────────────────────────────────────────
# Opciones: mock | http
# CRÍTICO: DIAN_PROVIDER=mock NO está permitido en NODE_ENV=production.
#          Un worker de producción corriendo con mock no enviará documentos reales a la DIAN.
DIAN_PROVIDER=mock

# Requerido cuando DIAN_PROVIDER=http:
DIAN_HTTP_URL=https://api.provider.com/v1/dian
# Requerido (mín. 8 caracteres) cuando DIAN_PROVIDER=http.
# El worker rechazará el arranque si DIAN_PROVIDER=http y este campo está vacío.
DIAN_HTTP_API_KEY=your_generic_provider_api_key_here
DIAN_HTTP_TIMEOUT_MS=15000

# C4: Tiempo (ms) sin actualización antes de recheck de documentos DIAN en SENT (default 10 min)
DIAN_SENT_RECHECK_DELAY_MS=600000

# ── Configuraciones de Negocio ────────────────────────────────────────────────
# C9: Ventana máxima en horas para anular una venta (default 24h)
SALE_VOID_MAX_AGE_HOURS=24

# ── Worker Tuning ─────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_RETRY_BASE_MS=30000
OUTBOX_RETRY_MAX_MS=3600000

NODE_ENV=development
