# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de configuración. Copia a `.env` y rellena lo que marque CAMBIAR o GENERAR.
#
# Generado por scripts/reorganizar-env.mjs — mantén el orden y los comentarios al día.
# Los valores por defecto del código están en apps/api/src/app/env.ts y
# apps/worker/src/config/env.ts; una variable ausente toma ese valor.
#
# Ojo: `FOO=` es cadena vacía para Node, no «sin configurar». El código la normaliza a
# undefined antes de validar, pero conviene borrar la línea si no se usa.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Entorno ───────────────────────────────────────────────────────────────────

# development | test | production. En production se activan validaciones extra.
NODE_ENV=development

# Puerto de la API.
PORT=3000

# Interfaz donde escucha la API. 0.0.0.0 la expone a toda la red.
HOST=127.0.0.1

# Margen para drenar peticiones en vuelo al recibir SIGTERM.
SHUTDOWN_TIMEOUT_MS=25000

# Puerto del healthcheck del worker.
WORKER_PORT=3001

# ─── Base de datos y Redis ─────────────────────────────────────────────────────
#
# Dos conexiones a propósito (fase 2): la API usa un rol SIN BYPASSRLS, de modo que el
# aislamiento entre comercios lo aplica PostgreSQL y no la disciplina de quien escribe
# la consulta. Migraciones y semillas usan el rol dueño.

# Conexión de la API. Rol restringido, sin BYPASSRLS.
DATABASE_URL=postgres://pos_api:CAMBIAR@localhost:5432/pos_dian

# Rol dueño del esquema: migraciones, semillas y worker.
ADMIN_DATABASE_URL=postgres://pos:CAMBIAR@localhost:5432/pos_dian

# Conexiones máximas del pool de la API.
DATABASE_POOL_MAX=10

# Contraseña del Postgres de docker-compose.
POSTGRES_PASSWORD=CAMBIAR

# Rate limit de login, caché de entitlements y colas.
REDIS_URL=redis://localhost:6379

# ─── Sesión y autenticación ────────────────────────────────────────────────────

# Firma los tokens de sesión de TODOS los comercios.
# Generar con: openssl rand -base64 48
# En producción se rechaza si parece un valor de ejemplo o tiene menos de 16
# caracteres distintos — 32 caracteres pueden seguir siendo triviales.
JWT_SECRET=GENERAR_CON_openssl_rand_base64_48

# Vida del token de acceso.
JWT_EXPIRES_IN=15m

# Vida del refresh token (cookie httpOnly).
REFRESH_TOKEN_EXPIRES_IN=7d

# Intentos de login permitidos por ventana.
AUTH_LOGIN_RATE_LIMIT_MAX=5

# Duración de esa ventana.
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Orígenes permitidos, separados por coma. OBLIGATORIO en producción.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Facturación electrónica (DIAN / PAC) ──────────────────────────────────────
#
# DIAN_PROVIDER=mock devuelve CUDEs inventados: sirve para desarrollo y está prohibido
# en producción (la API y el worker se niegan a arrancar).

# mock | http. En producción, siempre http.
DIAN_PROVIDER=mock

# Endpoint del PAC. Obligatorio si DIAN_PROVIDER=http.
DIAN_HTTP_URL=

# Clave que entrega el PAC. Obligatoria (mín. 8 caracteres) si DIAN_PROVIDER=http.
DIAN_HTTP_API_KEY=

# Tiempo máximo de espera al PAC.
DIAN_HTTP_TIMEOUT_MS=10000

# AES-256-GCM para las credenciales del PAC guardadas por comercio.
# Generar con: openssl rand -hex 32
# OBLIGATORIA en producción: sin ella quedarían en texto plano en la base.
CREDENTIALS_ENCRYPTION_KEY=GENERAR_CON_openssl_rand_hex_32

# HMAC-SHA256 del webhook de estado del PAC.
# Generar con: openssl rand -hex 32
# Sin ella el webhook se acepta sin verificar y solo queda un aviso en el log.
DIAN_WEBHOOK_SECRET=GENERAR_CON_openssl_rand_hex_32

# Espera antes de reconsultar un documento que quedó en SENT.
DIAN_SENT_RECHECK_DELAY_MS=600000

# Horas tras las cuales un documento sin resolver genera alerta.
DIAN_SENT_ALERT_HOURS=6

# ─── Pasarelas de pago (suscripción del SaaS) ──────────────────────────────────
#
# Son las que cobran la suscripción a los comercios, no las ventas del punto de venta.
# Sin ellas el checkout responde, pero ningún cobro se procesa.

# Wompi → Desarrolladores → Llaves. Empieza por pub_test_ o pub_prod_. Es la única que ve el navegador.
WOMPI_PUBLIC_KEY=

# Wompi → llave de EVENTOS (firma los webhooks). Distinta de la privada.
WOMPI_EVENTS_KEY=

# Wompi → llave PRIVADA (prv_...). Autoriza el cobro recurrente server-to-server. Nunca sale al frontend.
WOMPI_PRIVATE_KEY=

# https://sandbox.wompi.co/v1 en pruebas, https://production.wompi.co/v1 en producción.
WOMPI_API_URL=https://sandbox.wompi.co/v1

# MercadoPago → Tus integraciones → Credenciales.
MERCADOPAGO_ACCESS_TOKEN=

# MercadoPago → Webhooks → clave secreta de la notificación.
MERCADOPAGO_WEBHOOK_SECRET=

# Stripe → Developers → API keys → Secret key (sk_...).
STRIPE_SECRET_KEY=

# Stripe → Webhooks → endpoint → Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=

# ─── Ciclo de suscripción ──────────────────────────────────────────────────────

# Días de prueba al registrarse.
BILLING_TRIAL_DAYS=14

# Días en mora antes de suspender. Durante la gracia la caja sigue funcionando.
BILLING_GRACE_PERIOD_DAYS=7

# Reintentos tras el primer cobro fallido. Con 3: cobro, 24 h, 72 h y una semana.
BILLING_MAX_RETRIES=3

# Días tras los cuales una suscripción impaga se suspende.
BILLING_SUSPENSION_AFTER_DAYS=30

# WOMPI | MOCK. Solo Wompi guarda medios de pago reutilizables; las demás quedan como pago manual.
BILLING_RECURRING_GATEWAY=WOMPI

# IVA sobre la suscripción, desglosado en la factura.
BILLING_TAX_RATE=0.19

# Prefijo del consecutivo de facturas del SaaS (POS-000123).
BILLING_INVOICE_PREFIX=POS

# Días de plazo de la factura antes de considerarla vencida.
BILLING_INVOICE_DUE_DAYS=3

# Descuento por defecto al derivar el plan anual de uno mensual.
BILLING_YEARLY_DISCOUNT_PERCENT=15

# A dónde llevan los correos de cobranza. Sin esto avisan de qué pasó pero no de dónde arreglarlo.
BILLING_PORTAL_URL=http://localhost:5173/billing

# ─── Notificaciones ────────────────────────────────────────────────────────────

# RESEND | SENDGRID.
NOTIFICATION_PROVIDER=RESEND

# resend.com → API Keys. OBLIGATORIA en producción con RESEND. Verifica también el dominio del remitente.
RESEND_API_KEY=

# ─── Bandeja de salida y reglas de negocio ─────────────────────────────────────

# Cada cuánto revisa el worker la bandeja de salida.
OUTBOX_POLL_INTERVAL_MS=5000

# Eventos por lote (máx. 500).
OUTBOX_BATCH_SIZE=50

# Base del backoff exponencial.
OUTBOX_RETRY_BASE_MS=30000

# Techo del backoff.
OUTBOX_RETRY_MAX_MS=3600000

# Ventana durante la cual se puede anular una venta.
SALE_VOID_MAX_AGE_HOURS=24

# ─── Caché y observabilidad ────────────────────────────────────────────────────

# TTL de las métricas del panel de plataforma.
CACHE_DASHBOARD_METRICS_TTL_S=120

# TTL de las métricas de crecimiento.
CACHE_GROWTH_METRICS_TTL_S=600

# TTL de las métricas de facturación.
CACHE_BILLING_METRICS_TTL_S=300

# Protege /metrics en producción (mín. 16 caracteres).
# Generar con: openssl rand -hex 24
# Sin token, /metrics responde 404 en producción en vez de exponer rutas y latencias.
METRICS_TOKEN=GENERAR_CON_openssl_rand_hex_24

# ─── Frontend (build de Vite) ──────────────────────────────────────────────────

# URL de la API que compila la PWA.
VITE_API_URL=http://localhost:3000/api/v1
