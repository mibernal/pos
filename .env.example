# ── Infraestructura Base ────────────────────────────────────────────────────────
PORT=3000
WORKER_PORT=8080

# IMPORTANTE: Para que RLS funcione localmente o en prod, la API DEBE conectarse con un usuario 
# que asuma el rol 'api_user' (ej: pos_api), de lo contrario si se conecta como 'pos' (dueño de BD)
# el Postgres ignorará RLS y devolverá todos los datos saltando el multi-tenant.
# DATABASE_URL=postgres://pos_api:pos_api@localhost:5432/pos_dian
DATABASE_URL=postgres://pos:pos@localhost:5432/pos_dian
REDIS_URL=redis://localhost:6379

# ── Seguridad y Autenticación ─────────────────────────────────────────────────
JWT_SECRET=replace-this-in-production-with-a-long-secret
JWT_EXPIRES_IN=8h
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000

# ── DIAN Provider ─────────────────────────────────────────────────────────────
# Opciones: mock | http
# CRÍTICO: DIAN_PROVIDER=mock NO está permitido en NODE_ENV=production.
#          Un worker de producción corriendo con mock no enviará documentos reales a la DIAN.
DIAN_PROVIDER=mock

# Requerido cuando DIAN_PROVIDER=http:
DIAN_HTTP_URL=https://api.provider.com/v1/dian
# Requerido (mín. 8 caracteres) cuando DIAN_PROVIDER=http.
# El worker rechazará el arranque si DIAN_PROVIDER=http y este campo está vacío.
DIAN_HTTP_API_KEY=your_generic_provider_api_key_here
DIAN_HTTP_TIMEOUT_MS=15000

# C4: Tiempo (ms) sin actualización antes de recheck de documentos DIAN en SENT (default 10 min)
DIAN_SENT_RECHECK_DELAY_MS=600000

# ── Configuraciones de Negocio ────────────────────────────────────────────────
# C9: Ventana máxima en horas para anular una venta (default 24h)
SALE_VOID_MAX_AGE_HOURS=24

# ── Worker Tuning ─────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_RETRY_BASE_MS=30000
OUTBOX_RETRY_MAX_MS=3600000

NODE_ENV=development
