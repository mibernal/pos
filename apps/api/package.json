{
  "name": "@pos-dian/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <=24"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/index.ts",
    "db:migrate": "node --env-file=../../.env --import tsx src/shared/infra/db/migrate.ts",
    "db:seed": "node --env-file=../../.env --import tsx src/shared/infra/db/seed.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "NODE_ENV=test JWT_SECRET=test-secret-that-is-at-least-thirty-two-chars-long vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/lib-storage": "^3.750.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.47.1",
    "@opentelemetry/core": "^1.26.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.53.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-metrics": "^1.26.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "@pos-dian/shared": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^5.44.0",
    "fastify": "^5.2.1",
    "fastify-metrics": "^12.0.0",
    "fastify-plugin": "^5.0.1",
    "fastify-socket.io": "^5.1.0",
    "fastify-type-provider-zod": "^5.0.0",
    "ioredis": "^5.5.0",
    "kysely": "^0.27.6",
    "papaparse": "^5.4.1",
    "pg": "^8.13.3",
    "pino-loki": "^2.3.1",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "resend": "^4.1.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "stripe": "^14.20.0",
    "mercadopago": "^2.0.15",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "@types/papaparse": "^5.3.14",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
